# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key, used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# The Veilcast market contract (cairo/src/market.cairo), per network. The board, the
# odds and every bet read and write here, so the app has nothing to show without it.
# "0x0" = not deployed on that network yet, and the app says so rather than pretending
# to have a board. Deploy one with cairo/scripts/deploy.sh, then paste the address.
NEXT_PUBLIC_VEILCAST_MARKET_MAINNET=0x0
NEXT_PUBLIC_VEILCAST_MARKET_SEPOLIA=0x0
