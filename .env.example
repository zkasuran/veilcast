# Copy this file to .env.local and fill in your values. Both blocks are optional:
# with an empty file the app talks to a keyless public RPC and tells you no market
# is deployed, which is exactly what a fresh clone should do.

# (Optional) Alchemy Starknet RPC key. Without it the app uses the public Cartridge
# endpoints, which are keyless and rate-limited. With it, both networks go through
# Alchemy instead. Paste ONLY the key; the URL is built in src/utils/constants.ts.
NEXT_PUBLIC_PROVIDER_URL=

# The Veilcast market contract (cairo/src/market.cairo), per network. The board, the
# odds and every bet read and write here, so the app has nothing to show without it.
# "0x0" or empty = not deployed on that network yet, and the app says so rather than
# pretending to have a board. Deploy one with cairo/scripts/deploy.sh, then paste it.
NEXT_PUBLIC_VEILCAST_MARKET_MAINNET=0x0
NEXT_PUBLIC_VEILCAST_MARKET_SEPOLIA=0x0

# (Optional) Path the app is served under, for a static host that is not the root.
# The GitHub Pages workflow sets this to /veilcast. Leave empty for local dev.
NEXT_PUBLIC_BASE_PATH=
